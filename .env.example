# Neon connection string (Neon dashboard -> Connect). Use the pooled one if offered.
DATABASE_URL=postgresql://user:password@ep-dummy-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Daily email report (optional) ---
# The Gmail account that SENDS the report. Use a Google "App Password", not the normal password
# (Google Account -> Security -> 2-Step Verification on -> App passwords).
# Who receives it, the time, and the on/off switch are set in the app under Settings.
#GMAIL_USER=sender.account@gmail.com
#GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Only needed once the app is online: a secret that an outside timer must send to /api/cron/daily-email
#CRON_SECRET=pick-a-long-random-text
